<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>nikhil b lal - Portfolio</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Georgia, 'Times New Roman', serif;
            background: white;
            color: #111;
            line-height: 1.6;
        }

        .container {
            min-height: 100vh;
            padding: 4rem 2rem;
        }

        .grid {
            max-width: 1600px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, 270px);
            gap: 2.5rem;
            justify-content: center;
            transition: grid-template-columns 0.3s ease;
        }

        /* Info Box */
        .info-box {
            aspect-ratio: 1;
            border-radius: 0.5rem;
            background: white;
            border: 2px solid #111;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 1.5rem;
            transition: background-color 0.3s ease;
            overflow: hidden;
            position: relative;
            min-width: 270px;
        }

        .info-box:hover {
            background: #f9f9f9;
        }

        .info-content {
            text-align: center;
        }

        .info-box h1 {
            font-size: 1.5rem;
            font-weight: 500;
            margin-bottom: 0.25rem;
            color: #111;
        }

        .info-box .subtitle {
            font-size: 1rem;
            color: #666;
            margin-bottom: 2rem;
        }

        .nav-links {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .nav-row {
            display: flex;
            gap: 0.25rem;
            justify-content: center;
            flex-wrap: wrap;
            align-items: center;
        }

        .nav-links a {
            color: #111;
            text-decoration: underline;
            text-decoration-thickness: 1px;
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
            transition: all 0.2s;
        }

        .nav-links a:hover {
            background: black;
            color: white;
        }

        /* Portfolio Box */
        .portfolio-box {
            position: relative;
            aspect-ratio: 1;
            min-width: 270px;
        }

        .portfolio-box-inner {
            position: relative;
            aspect-ratio: 1;
            overflow: hidden;
            border-radius: 0.5rem;
            background: #f5f5f5;
            transition: transform 0.3s ease;
            cursor: pointer;
            z-index: 10;
        }

        .portfolio-box:hover .portfolio-box-inner {
            transform: scale(1.02);
        }

        .portfolio-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        /* GIF indicator badge */
        .portfolio-box[data-animated]::after {
            content: 'GIF';
            position: absolute;
            top: 0.75rem;
            right: 0.75rem;
            background: rgba(0, 0, 0, 0.75);
            color: white;
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
            font-size: 0.75rem;
            font-weight: 500;
            letter-spacing: 0.5px;
            z-index: 20;
            transition: opacity 0.3s ease;
            pointer-events: none;
        }

        .portfolio-box[data-animated]:hover::after {
            opacity: 0.5;
        }

        /* Expanding animation rings */
        .breathe-ring {
            position: absolute;
            border: 2px solid black;
            border-radius: 0.5rem;
            opacity: 0;
            pointer-events: none;
            inset: 0;
        }

        .portfolio-box:hover .breathe-ring {
            animation: expand 0.9s linear infinite;
        }

        .breathe-ring-1 {
            animation-delay: 0s;
        }

        .breathe-ring-2 {
            animation-delay: 0.2s;
        }

        .breathe-ring-3 {
            animation-delay: 0.4s;
        }

        .breathe-ring-4 {
            display: none;
        }

        @keyframes expand {
            0% {
                transform: scale(1);
                opacity: 1;
            }
            100% {
                transform: scale(1.15);
                opacity: 0;
            }
        }

        /* Responsive adjustments */
        @media (max-width: 768px) {
            .container {
                padding: 2rem 1rem;
            }

            .grid {
                grid-template-columns: repeat(auto-fit, 270px);
                gap: 1.5rem;
            }

            .info-box h1 {
                font-size: 1.25rem;
            }

            .info-box .subtitle {
                font-size: 0.875rem;
            }
        }

        /* Single column: fill width */
        @media (max-width: 640px) {
            .grid {
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
            }

            .info-box,
            .portfolio-box {
                min-width: unset;
                max-width: 100%;
                width: 100%;
            }

            .portfolio-box-inner {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="grid">
            <!-- Info Box -->
            <div class="info-box">
                <div class="info-content">
                    <h1>nikhil b lal</h1>
                    <p class="subtitle">engineer, inventor, researcher</p>

                    <div class="nav-links">
                        <div class="nav-row">
                            <a href="/about/">about</a>
                            <a href="/Curriculum_Vitae.pdf">curriculum vitae</a>
                            <a href="/projects/">projects</a>
                        </div>
                        <div class="nav-row">
                            <a href="https://patents.justia.com/inventor/nikhil-b-lal" target="_blank">patents</a>
                            <a href="https://scholar.google.com/citations?user=GLdoyI4AAAAJ" target="_blank">papers</a>
                            <a href="https://github.com/nikhilblal" target="_blank">github</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Portfolio Items -->
            <% it.projects.forEach(function(project) { %>
                <% if (project.images && project.images.length > 0) { %>
                <% const img = project.images[0]; %>
                <a href="<%= project.url %>" class="portfolio-box" <%~ img.isGif ? `data-animated="${img.animated}"` : '' %>>
                    <div class="breathe-ring breathe-ring-1"></div>
                    <div class="breathe-ring breathe-ring-2"></div>
                    <div class="breathe-ring breathe-ring-3"></div>
                    <div class="breathe-ring breathe-ring-4"></div>
                    <div class="portfolio-box-inner">
                        <img src="<%= img.static %>" alt="<%= project.title %>" loading="lazy">
                    </div>
                </a>
                <% } %>
            <% }); %>
        </div>
    </div>
    <script>
        // Handle GIF hover animation
        document.querySelectorAll('.portfolio-box[data-animated]').forEach(box => {
            const img = box.querySelector('img');
            const staticSrc = img.src;
            const animatedSrc = box.getAttribute('data-animated');

            box.addEventListener('mouseenter', () => {
                img.src = animatedSrc;
            });

            box.addEventListener('mouseleave', () => {
                img.src = staticSrc;
            });
        });

        // Dynamic column calculation based on viewport dimensions
        function updateGridColumns() {
            const grid = document.querySelector('.grid');
            const container = document.querySelector('.container');

            // Get viewport dimensions
            const viewportHeight = window.innerHeight;
            const viewportWidth = window.innerWidth;

            // Calculate container padding (4rem top + 4rem bottom = 8rem)
            const remSize = parseFloat(getComputedStyle(document.documentElement).fontSize);
            const verticalPadding = 8 * remSize;

            // Available height for grid
            const availableHeight = viewportHeight - verticalPadding;

            // Item dimensions (aspect-ratio: 1, plus gap)
            const gap = 2.5 * remSize;
            const itemSize = 270; // Use 270px for calculations to fit more rows

            // Calculate how many rows can fit in viewport
            const maxRows = Math.max(1, Math.floor((availableHeight + gap) / (itemSize + gap)));

            // Count total items (including info box)
            const totalItems = grid.children.length;

            // Calculate minimum columns needed to fit all items in maxRows
            const minColumnsForHeight = Math.ceil(totalItems / maxRows);

            // Calculate maximum columns that fit in viewport width
            const containerPadding = 4 * remSize; // 2rem on each side
            const availableWidth = Math.min(viewportWidth - containerPadding, 1600); // respect max-width
            const maxColumnsForWidth = Math.max(1, Math.floor((availableWidth + gap) / (itemSize + gap)));

            // Use the minimum of the two - we need at least minColumnsForHeight, but can't exceed maxColumnsForWidth
            // If we need more columns than fit, we'll have to accept some vertical scrolling
            const optimalColumns = Math.min(minColumnsForHeight, maxColumnsForWidth);

            // Apply the column count
            grid.style.gridTemplateColumns = `repeat(${optimalColumns}, 270px)`;
        }

        // Run on load and resize
        updateGridColumns();
        window.addEventListener('resize', updateGridColumns);

        // Mobile GIF autoplay
        const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) || window.innerWidth <= 768;

        if (isMobile) {
            // On mobile, show animated GIFs by default
            document.querySelectorAll('.portfolio-box[data-animated]').forEach(box => {
                const img = box.querySelector('img');
                const animatedSrc = box.getAttribute('data-animated');
                img.src = animatedSrc;
            });
        }
    </script>
</body>
</html>
